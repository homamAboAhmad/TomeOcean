          <w14:shadow w14:blurRad="50800" w14:dist="38100" w14:dir="2700000" w14:sx="100000" w14:sy="100000" w14:kx="0" w14:ky="0" w14:algn="tl">
            <w14:srgbClr w14:val="000000">
              <w14:alpha w14:val="60000"/>
            </w14:srgbClr>
          </w14:shadow>
        </w:rPr>
        <w:t>-قال المحبوس عمر الحدوشي: ومن هذا القبيل الإشهارات التي يقوم بها الإعلاميون للبضائع المحرمة مأكولاً ومشروباً، والدعاء إلى ممارسة اليانصيب، والدعاء إلى الفاحشة باسم اتخاذ أصدقاء جددٍ، وكذا الدعوة إلى تشريع القوانين الوضعية التي تصادم الشريعة الإسلامية، والجمعيات التي تدعو النساء العاريات-تحت مسميات براقة: "حقوق النساء"-إلى التمرد على شرع الله تعالى، والدعاء إلى محاربة الإسلام باسم: (محاربة الإرهاب)، فإذا أمعنا النظر وجدنا كثيراً من الدول والحكومات والقنوات ولإذاعات والجرائد والمجلات والأفلام والمسلسلات والمسرحيات ومن يسمون فنانين، والقضاء المحرك بأيد خفية، هؤلاء كلهم ينبغي أن نتعامل معهم بهذا الحديث النبوي، بل: هم أحق به من غيرهم.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="7B57C177" w14:textId="77777777" w:rsidR="006F1485" w:rsidRPr="003E7210" w:rsidRDefault="006F1485" w:rsidP="00403289">
