          <w:rtl/>
          <w14:shadow w14:blurRad="50800" w14:dist="38100" w14:dir="2700000" w14:sx="100000" w14:sy="100000" w14:kx="0" w14:ky="0" w14:algn="tl">
            <w14:srgbClr w14:val="000000">
              <w14:alpha w14:val="60000"/>
            </w14:srgbClr>
          </w14:shadow>
        </w:rPr>
        <w:t>وأضافت الرسالة الشيوعية: نأمل من دورتكم المقبلة تصحيح هذا الوضع واتخاذ موقف واضح من التصريحات الشاذة وغير المسؤولة والمنحازة، الصادرة عن هذا القيادي في حزبكم الذي وضع نفسه من خلال التصريح المذكور في صف أعداء الحقيقة وأعداء حقوق الإنسان-اللهم اضرب الظالمين بالظالمين وأخرجنا من بينهم سالمين غانمين-والناصري ونبيل عبد الله يعتبران في عصرنا مصنع الكذب والافتراء والإفك والبهتان، يخلقون ما يقولون-بل: المدعو الناصري يضع التنصير والسلفية الجهادية في كفة واحدة، كل أحد له نقاط ضعف إلا الاشتراكيون فكلهم ضعف.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="2589A9BB" w14:textId="77777777" w:rsidR="006F1485" w:rsidRPr="003E7210" w:rsidRDefault="006F1485" w:rsidP="00403289">
