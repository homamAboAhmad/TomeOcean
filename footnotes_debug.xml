          <w:spacing w:val="12"/>
          <w:sz w:val="24"/>
          <w:szCs w:val="24"/>
          <w:rtl/>
        </w:rPr>
        <w:t>أقول: والظاهر-أيضاً-أنه لم يرو حديثنا عن ابن عيينة إلا هو، وابن عيينة له أصحاب متوافرون ومنهم جملة من الأئمة المبرزين، فأين كانوا مما يتفرد به هذا البصري عن ابن عيينة؟.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="07714E34" w14:textId="77777777" w:rsidR="006F1485" w:rsidRPr="003E7210" w:rsidRDefault="006F1485" w:rsidP="00403289">
