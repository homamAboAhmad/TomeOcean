          <w:szCs w:val="24"/>
          <w:rtl/>
        </w:rPr>
        <w:t xml:space="preserve">-والطحاوي نسبة إلى طحية قرية بصعيد مصر، وقد ذكره السيوطي في: "حسن المحاضرة" في حفاظ الحديث وقال: كان ثقة فقيهاً، لم يخلف بعده مثله انتهت إليه رياسة الحنفيه بمصر.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="7DF0BFBA" w14:textId="77777777" w:rsidR="006F1485" w:rsidRPr="003E7210" w:rsidRDefault="006F1485" w:rsidP="00403289">
