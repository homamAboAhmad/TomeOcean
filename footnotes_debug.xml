          <w:spacing w:val="12"/>
          <w:sz w:val="24"/>
          <w:szCs w:val="24"/>
        </w:rPr>
      </w:pPr>
      <w:r w:rsidRPr="003E7210">
        <w:rPr>
          <w:rFonts w:ascii="Traditional Arabic" w:hAnsi="Traditional Arabic"/>
          <w:b/>
          <w:bCs/>
          <w:color w:val="000000"/>
          <w:spacing w:val="12"/>
          <w:sz w:val="24"/>
          <w:szCs w:val="24"/>
          <w:rtl/>
        </w:rPr>
        <w:t>وخالف محررا (أحكام التقريب) (3/178/رقم:5518) الشيخ الألباني فقالا: (لم يتعرض المصنف هنا لتدليسه، وقال في مقدمة: "الفتح": ربما دلس، وذكره في: "طبقات المدلسين" في الطبقة الثالثة، وهي التي لا يقبل حديث أصحابها إلا إذا صرحوا بالسماع، وقال: مشهور بالتدليس، وعده الذهبي من المدلسين في منظومته فيهم، وفي: "التهذيب" عدد غير قليل ذكر الأئمة أنه لم يسمع منهم، وقال العلائي: "أحد المشهورين بالتدليس").</w:t>
      </w:r>
    </w:p>
  </w:footnote>
