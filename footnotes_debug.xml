          <w:b/>
          <w:bCs/>
          <w:color w:val="000000"/>
          <w:sz w:val="24"/>
          <w:szCs w:val="24"/>
          <w:rtl/>
        </w:rPr>
        <w:t>وكتب التاريخ شاهدة على ما قلنا</w:t>
      </w:r>
