            <w14:srgbClr w14:val="000000">
              <w14:alpha w14:val="60000"/>
            </w14:srgbClr>
          </w14:shadow>
        </w:rPr>
        <w:t xml:space="preserve">لتي فيه-وكذا بعض الأحاديث</w:t>
      </w:r>
      <w:r w:rsidRPr="003E7210">
