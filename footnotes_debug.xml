          <w:b/>
          <w:bCs/>
          <w:color w:val="000000"/>
          <w:spacing w:val="12"/>
          <w:sz w:val="24"/>
          <w:szCs w:val="24"/>
          <w:rtl/>
        </w:rPr>
        <w:t>، والشأن في هذا كما قلت في أرجوزتي الدالية:</w:t>
      </w:r>
    </w:p>
