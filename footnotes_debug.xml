          <w:sz w:val="24"/>
          <w:szCs w:val="24"/>
          <w:rtl/>
        </w:rPr>
      </w:pPr>
      <w:r w:rsidRPr="003E7210">
        <w:rPr>
          <w:rFonts w:ascii="Traditional Arabic" w:hAnsi="Traditional Arabic"/>
          <w:b/>
          <w:bCs/>
          <w:color w:val="000000"/>
          <w:spacing w:val="12"/>
          <w:sz w:val="24"/>
          <w:szCs w:val="24"/>
          <w:rtl/>
        </w:rPr>
        <w:t>ولم يثبت في حقه توثيق معتبر! فضلاً عن أن يكون من الحفاظ الذين يعتمد على تفردهم بمثل هذا. فالإسناد غريب من جهة هذا التفرد، والله تعالى أعلم. (كذا قال)</w:t>
      </w:r>
    </w:p>
  </w:footnote>
