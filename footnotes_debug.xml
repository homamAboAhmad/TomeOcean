          <w:bCs/>
          <w:color w:val="000000"/>
          <w:spacing w:val="12"/>
          <w:sz w:val="24"/>
          <w:szCs w:val="24"/>
          <w:rtl/>
        </w:rPr>
        <w:t>ونجد في: "الصحيحين"-وغيرهما-أحاديث كثيرة جداً لقتادة بالعنعنة، حتى ابن حبان الذي وصفه بالتدليس، قد أكثر عنه بها، ويحتمل أن ذلك كان منهم لأنه كان-كما قال الحاكم-: لا يدلس إلا عن ثقة كما نقله العلائي في كتابه القيم: "جامع التحصيل" "112").</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="1F0A8001" w14:textId="77777777" w:rsidR="006F1485" w:rsidRPr="003E7210" w:rsidRDefault="006F1485" w:rsidP="00403289">
