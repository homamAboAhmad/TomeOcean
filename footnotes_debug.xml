          <w:szCs w:val="24"/>
          <w:rtl/>
        </w:rPr>
        <w:t>-قال أبو أنس إبراهيم الصبيحي في: (النكت) (ص:603/رقم:702): وقد ذكر الخطيب في ترجمة: الباهلي هذا حديثاً من رواية عن ابن عيينة، ثم قال الخطيب: يقال لم يروه عن سفيان بن عيينة إلا محمد بن عمرو الباهلي.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="53693DB6" w14:textId="77777777" w:rsidR="006F1485" w:rsidRPr="003E7210" w:rsidRDefault="006F1485" w:rsidP="00403289">
