w:rsidRDefault="00591EE6" w:rsidP="00B60092"><w:pPr><w:pStyle w:val="FootnoteText"/><w:ind w:left="340" w:hanging="340"/><w:jc w:val="lowKashida"/><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidRPr="00B60092"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:color w:val="0000FF"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:vertAlign w:val="baseline"/><w:rtl/></w:rPr><w:t>(</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:color w:val="0000FF"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:vertAlign w:val="baseline"/><w:rtl/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:color w:val="0000FF"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:vertAlign w:val="baseline"/><w:rtl/></w:rPr><w:t>)</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve"> وقد سماها الشيخ في موقعه كذلك باسم: «زهر الخمائل في مسائل النوازل»، وعلى هذا فللكتاب اسمان، ولأن اسم «الاجتهاد في نوازل الجهاد» يشابهه عنوان كتابٍ للشيخ أبي قتادة باسم «الاجتهاد والجهاد</w:t></w:r><w:r w:rsidR="000E3A9A" w:rsidRPr="000E3A9A"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>..</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve"> تأملات في الـمنهج»، وللإمام ابن كثير كتاب باسم «الاجتهاد في طلب الجهاد»، وعلى هذا اخترنا جعل الكتاب باسمه الذي لا يشابهه غره، وهو «زهر الخمائل» مع إثبات اسمه الآخر كذلك</w:t></w:r><w:r w:rsidR="000E3A9A" w:rsidRPr="000E3A9A"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>.</w:t></w:r></w:p></w:footnote><w:footnote w:id="2"><w:p w14:paraId="613EC7CF" w14:textId="32CF7EAB" w:rsidR="00591EE6" w:rsidRPr="00B60092" w:rsidRDefault="00591EE6" w:rsidP="00B60092"><w:pPr><w:pStyle w:val="FootnoteText"/><w:ind w:left="340" w:hanging="340"/><w:jc w:val="lowKashida"/><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidRPr="00B60092"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:color w:val="0000FF"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:vertAlign w:val="baseline"/><w:rtl/></w:rPr><w:t>(</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:color w:val="0000FF"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:vertAlign w:val="baseline"/><w:rtl/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:color w:val="0000FF"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:vertAlign w:val="baseline"/><w:rtl/></w:rPr><w:t>)</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve"> غالب الأسئلة تتمحور في الحقيقة حول مسائل الجهاد، وقد بلغ مجموع الأسئلة التي أثبتناها في هذا الكتاب: </w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype" w:hint="cs"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>(</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>75</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype" w:hint="cs"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>)</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve"> سؤالًا، غالبها متعلق بالـمجاهدين أو فيه إفادة لهم بالخصوص، أو يعالج بعض الأمراض التي عندهم، وقد أحصيت الأسئلة التي لا علاقة لها بالـمجاهدين أو واقعهم فوجدتها لا تزيد عن عشرة أسئلة معظمها في القسمين الأخيرين من الكتاب: «كتاب التعببر، ومتفرقات الـمسائل»، وعلى هذا فالكتاب يدور حول النوازل الجهادية الـمعاصرة</w:t></w:r><w:r w:rsidR="000E3A9A" w:rsidRPr="000E3A9A"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>.</w:t></w:r></w:p></w:footnote><w:footnote w:id="3"><w:p w14:paraId="45E038BA" w14:textId="4393433D" w:rsidR="00B60092" w:rsidRDefault="00591EE6" w:rsidP="00B60092"><w:pPr><w:pStyle w:val="FootnoteText"/><w:ind w:left="340" w:hanging="340"/><w:jc w:val="lowKashida"/><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr></w:pPr><w:r w:rsidRPr="00B60092"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:color w:val="0000FF"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:vertAlign w:val="baseline"/><w:rtl/></w:rPr><w:t>(</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:color w:val="0000FF"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:vertAlign w:val="baseline"/><w:rtl/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:color w:val="0000FF"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:vertAlign w:val="baseline"/><w:rtl/></w:rPr><w:t>)</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve"> قال أبو الوليد الباجي الـمالكي في كتابه «التبيين لسنن الـمهتدين، ص 97» الـمتوفى سنة أربع وسبعين وأربع</w:t></w:r><w:r w:rsidR="00B60092" w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype" w:hint="cs"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>مئة: «وكثيرًا ما يسألني من تقع له مسألة من الأَيْمان ونحوها: لعل فيها رواية؟ أو لعل فيها رخصة؟، وهم يرون أن هذا من الأمور الشائعة الجائزة، ولو كان تكرر عليهم إنكار الفقهاء لمثل هذا لما طالبوا به، ولا طلبوه مني ولا من سواي، وهذا مما لا خلاف بين الـمسلمين ممن يعتد به في الإجماع؛ أنه لا يجوز ولا يسـوغ ولا يحل لأحـد أن يفتي في دين الله إلا بالحق الذي يعتقد أنه حق، رضي بذلك من رضيه وسخطه من سخطه</w:t></w:r><w:r w:rsidR="000E3A9A" w:rsidRPr="000E3A9A"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="4439B069" w14:textId="02421158" w:rsidR="00591EE6" w:rsidRPr="00B60092" w:rsidRDefault="00591EE6" w:rsidP="00B60092"><w:pPr><w:pStyle w:val="FootnoteText"/><w:ind w:left="340"/><w:jc w:val="lowKashida"/><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr></w:pPr><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve">وإنما الـمفتي مخبر عن الله تعالى في حكمه؛ فكيف يخبر عنه إلا بما يعتقد أنه حَـكَمَ به وأوجبه؟ والله تعالى يقول لنبيه </w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:sym w:font="AGA Arabesque" w:char="F065"/></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve">: </w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="22"/><w:rtl/></w:rPr><w:t>﴿</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="KFGQPC Uthmanic Script HAFS"/><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>وَأَنِ احْكُم بَيْنَهُم بِمَآ أَنزَلَ اللّهُ وَلاَ تَتَّبِعْ أَهْوَاءهُمْ</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Sakkal Majalla" w:hint="cs"/><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="30"/><w:rtl/></w:rPr><w:t>﴾</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:color w:val="000000"/><w:rtl/></w:rPr><w:t>[الـمائدة من الآية: 49]</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve"> فكيف يجوز لهذا الـمفتي أن يفتي بما يشتهي، أو يفتي زيدًا بما لا يفتي به عَمْرًا لصداقة تكون بينهما أو غير ذلك من الأغراض!، وإنما يجب على الـمفتي أن يعلم أن الله أمره أن يحكم بما أنزل الله من الحق، فيجتهد في طلبه، وينهاه أن يخالفه وينحرف عنه، وكيف له بالخلاص مع كونه من أهل العلم والاجتهاد إلا بتوفيق الله وعونه وعصمته؟»</w:t></w:r><w:r w:rsidR="000E3A9A" w:rsidRPr="000E3A9A"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>.</w:t></w:r><w:r w:rsidR="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype" w:hint="cs"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>وانظر فتوى الشيخ أبي الوليد في كتابنا هذا تحت عنوان: «هل يلتزم مذ</w:t></w:r><w:r w:rsidR="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype" w:hint="cs"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>ه</w:t></w:r><w:r w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t>با في طلب العلم؟»</w:t></w:r><w:r w:rsidR="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype" w:hint="cs"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:rtl/></w:rPr><w:t xml:space="preserve"> (ص </w:t></w:r><w:r w:rsidR="00B60092"><w:rPr><w:rFonts w:ascii="Lotus Linotype" w:hAnsi="Lotus Linotype" w:cs="Lotus Linotype"/><w:sz w:v