لنوازل، مع محاولة وضع كل مسألة بجوار شبيهتها لتكتمل الفائدة</w:t></w:r><w:r w:rsidR="007E4265" w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Aljazeera" w:hAnsi="Aljazeera" w:cs="Aljazeera" w:hint="cs"/><w:color w:val="FF0000"/><w:sz w:val="32"/><w:szCs w:val="32"/><w:rtl/><w14:textFill><w14:gradFill><w14:gsLst><w14:gs w14:pos="0"><w14:srgbClr w14:val="FF0000"><w14:shade w14:val="30000"/><w14:satMod w14:val="115000"/></w14:srgbClr></w14:gs><w14:gs w14:pos="50000"><w14:srgbClr w14:val="FF0000"><w14:shade w14:val="67500"/><w14:satMod w14:val="115000"/></w14:srgbClr></w14:gs><w14:gs w14:pos="100000"><w14:srgbClr w14:val="FF0000"><w14:shade w14:val="100000"/><w14:satMod w14:val="115000"/></w14:srgbClr></w14:gs></w14:gsLst><w14:lin w14:ang="10800000" w14:scaled="0"/></w14:gradFill></w14:textFill></w:rPr><w:t xml:space="preserve">، وقد كان الكتاب في أصله مقسمًا إلى أبواب بحسب نشر الشيخ لها في موقعه الالكتروني على الشبكة، وهي: </w:t></w:r><w:r w:rsidR="004B465D" w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Aljazeera" w:hAnsi="Aljazeera" w:cs="Aljazeera" w:hint="cs"/><w:color w:val="FF0000"/><w:sz w:val="32"/><w:szCs w:val="32"/><w:rtl/><w14:textFill><w14:gradFill><w14:gsLst><w14:gs w14:pos="0"><w14:srgbClr w14:val="FF0000"><w14:shade w14:val="30000"/><w14:satMod w14:val="115000"/></w14:srgbClr></w14:gs><w14:gs w14:pos="50000"><w14:srgbClr w14:val="FF0000"><w14:shade w14:val="67500"/><w14:satMod w14:val="115000"/></w14:srgbClr></w14:gs><w14:gs w14:pos="100000"><w14:srgbClr w14:val="FF0000"><w14:shade w14:val="100000"/><w14:satMod w14:val="115000"/></w14:srgbClr></w14:gs></w14:gsLst><w14:lin w14:ang="10800000" w14:scaled="0"/></w14:gradFill></w14:textFill></w:rPr><w:t>«</w:t></w:r><w:r w:rsidR="007E4265" w:rsidRPr="00B60092"><w:rPr><w:rFonts w:ascii="Aljazeera" w:hAnsi="Aljazeera" w:cs="Aljazeera"/><w:color w:val="FF0000"/><w:sz w:val="32"/><w:szCs w:val="32"/><w:rtl/><w14:textFill><w14:gradFill><w14:gsLst><w14:gs w14:pos="0"><w14:srgbClr w14:val="FF0000"><w14:shade w14:va