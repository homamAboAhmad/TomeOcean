<w:p w14:paraId="434EECBF" w14:textId="77777777" w:rsidR="00210B77" w:rsidRPr="00210B77" w:rsidRDefault="00210B77" w:rsidP="00210B77"><w:pPr><w:spacing w:before="100" w:beforeAutospacing="1" w:after="100" w:afterAutospacing="1" w:line="192" w:lineRule="auto"/><w:ind w:firstLine="432"/><w:jc w:val="lowKashida"/><w:rPr><w:rFonts w:cs="Traditional Arabic"/><w:rtl/><w:lang w:bidi="ar-JO"/></w:rPr></w:pPr><w:r w:rsidRPr="00210B77"><w:rPr><w:rFonts w:cs="Traditional Arabic" w:hint="cs"/><w:rtl/><w:lang w:bidi="ar-JO"/></w:rPr><w:t>والآن سأتناول الجواب من خل</w:t></w:r><w:r><w:rPr><w:rFonts w:cs="Traditional Arabic" w:hint="cs"/><w:rtl/><w:lang w:bidi="ar-JO"/></w:rPr><w:t>ال النقاط التالية، سائلا الله</w:t></w:r><w:r w:rsidR="003C3E52"><w:rPr><w:rFonts w:cs="Traditional Arabic" w:hint="cs"/><w:rtl/><w:lang w:bidi="ar-JO"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rFonts w:cs="Traditional Arabic" w:hint="cs"/><w:rtl/><w:lang w:bidi="ar-JO"/></w:rPr><w:t>السداد في القول والعمل</w:t></w:r><w:r w:rsidRPr="00210B77"><w:rPr><w:rFonts w:cs="Traditional Arabic" w:hint="cs"/><w:rtl/><w:lang w:bidi="ar-JO"/></w:rPr><w:t>.</w:t></w:r></w:p>

