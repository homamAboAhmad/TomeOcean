    <w:t>، والغالِبُ عَلَى مَن يَتَكَلَّمُ فِي ذلكَ أَنَّهُمْ مِن العامَّةِ أوْ مِن صِغارِ الطّلَبِةِ، وقَدْ سَمِعْتُ بَعْضَهُمْ يَتَكَلَّمُ فِي أَحَدِ الـمجالِسِ فِي التكْفِيرِ والعُذْرِ بالجَهْلِ؛ وقَدْ تَطاوَلَ عَلى بَعْضِ العُلماءِ بِكَلامٍ أنْكَرْتُهُ عَلَيهِ، وقُلْتُ لَهُ</w:t>
  </w:r>
  <w:r w:rsidRPr="0026525E">
    <w:rPr>
      <w:rFonts w:ascii="Traditional Arabic" w:hAnsi="Traditional Arabic" w:cs="Lotus Linotype" w:hint="cs"/>
      <w:sz w:val="36"/>
      <w:szCs w:val="32"/>
      <w:rtl/>
    </w:rPr>
    <w:t xml:space="preserve">:</w:t>
  </w:r>
  <w:r w:rsidRPr="0026525E">
    <w:rPr>
      <w:rFonts w:ascii="Traditional Arabic" w:hAnsi="Traditional Arabic" w:cs="Lotus Linotype"/>
      <w:sz w:val="36"/>
      <w:szCs w:val="32"/>
      <w:rtl/>
    </w:rPr>
    <w:t xml:space="preserve">مِثْلُ هَذِهِ الـمسائلِ يَنْبَغِي أنْ يُرْجَعَ فِيها إلَى العُلَماءِ، ولَمّا سَألْتُهُ عَمّا حَصَّلَهُ مِن العِلْمِ؛ قالَ لِي: حَضَرْتُ دُرُوسًا عَلَى أَحَدِ الـمشايِخِ سِتَّةَ أشْهُرٍ!، فَقُلْتُ لَهُ: هَذا لا يُصَيِّرُكَ طالِبًا فَضْلًا عَن تَأهُّلِكَ للإفْتاءِ، فَأجابِنَي: بِأنَّهُ لا يُقَلِّدُ أحَدًا؛ وإِنَّما يَأخُذُ بالكِتابِ والسنَّةِ!، والسؤالُ هُو:</w:t>
  </w:r>
  <w:r w:rsidRPr="00095B64">
    <w:rPr>
      <w:rFonts w:ascii="Traditional Arabic" w:hAnsi="Traditional Arabic" w:cs="Lotus Linotype"/>
      <w:b/>
      <w:bCs/>
      <w:sz w:val="36"/>
      <w:szCs w:val="34"/>
      <w:rtl/>
    </w:rPr>
    <w:t>هَلْ يَجُوزُ لِمِثْلِهِ الإفْتاءُ فِي مِثْلِ هَذهِ الـمسائلِ أمْ لا؟؛ وإنْ كانَ الجَوابُ بِالـمنْعِ فَهَلِ الفَتْوى بِغَيرِ عِلْمٍ مَعْدُودَةٌ مِن صَغائرِ الذنُوبِ أم مِن الكبائر؟؛ وهَلْ كُنْتُ مُحِقًّا فِي الإنْكارِ عَلَيهِ أم لا؟؛ وهَلْ هُو مُصِيبٌ فِي قَولِهِ إِنَّهُ يَأخُذُ بالكِتابِ والسنَّةِ؟، فَأرْجُو التعْجِيلَ بالجَوابِ تَفْصِيلًا؛ لأنَّ الأمْرَ قَدْ أشْكَلَ عَلَينا</w:t>
  </w:r>
  <w:r w:rsidR="000E3A9A" w:rsidRPr="000E3A9A">
    <w:rPr>
      <w:rFonts w:ascii="Traditional Arabic" w:hAnsi="Traditional Arabic" w:cs="Lotus Linotype" w:hint="cs"/>
      <w:sz w:val="36"/>
